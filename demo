import torch
import torch.nn as nn
from torchvision import transforms
from PIL import Image
import os
from emonet.models import EmoNet

# =========================
# 路径配置
# =========================
img_path = "/content/drive/MyDrive/mask/picturetest/test1.jpg"
emotion_checkpoint = "/content/drive/MyDrive/mask/checkpoints/latest2.pt"
material_checkpoint = "/content/drive/MyDrive/mask/textcnn_ckpt4.pth"

device = torch.device("cuda" if torch.cuda.is_available() else "cpu")

# =========================
# 类别定义
# =========================
emotion_classes = ['Happy', 'Sad', 'Angry', 'Surprise', 'Fear', 'Disgust', 'Neutral']
material_classes = ["stained", "matted", "bumpy", "fibrous"]

# =========================
# 1. 加载情绪识别模型 (EmoNet)
# =========================
emotion_transform = transforms.Compose([
    transforms.Resize((256, 256)),
    transforms.ToTensor(),
    transforms.Normalize([0.5]*3, [0.5]*3)
])

emotion_model = EmoNet(n_expression=7).to(device)
checkpoint = torch.load(emotion_checkpoint, map_location=device)

# 如果checkpoint是dict且包含'model_state'
state_dict = checkpoint['model_state'] if isinstance(checkpoint, dict) and 'model_state' in checkpoint else checkpoint

# 删除不匹配的层（如果有）
keys_to_remove = ['emo_fc_2.3.weight', 'emo_fc_2.3.bias']
for key in keys_to_remove:
    if key in state_dict:
        del state_dict[key]

emotion_model.load_state_dict(state_dict, strict=False)
emotion_model.eval()

# =========================
# 2. 加载材质识别模型 (SimpleCNN)
# =========================
class SimpleCNN(nn.Module):
    def __init__(self, num_classes=4):
        super(SimpleCNN, self).__init__()
        self.features = nn.Sequential(
            nn.Conv2d(3, 32, kernel_size=3, padding=1), nn.ReLU(),
            nn.MaxPool2d(2),
            nn.Conv2d(32, 64, kernel_size=3, padding=1), nn.ReLU(),
            nn.MaxPool2d(2),
            nn.Conv2d(64, 128, kernel_size=3, padding=1), nn.ReLU(),
            nn.MaxPool2d(2),
        )
        self.classifier = nn.Sequential(
            nn.Flatten(),
            nn.Linear(128 * 16 * 16, 256),
            nn.ReLU(),
            nn.Dropout(0.5),
            nn.Linear(256, num_classes)
        )

    def forward(self, x):
        x = self.features(x)
        x = self.classifier(x)
        return x

material_transform = transforms.Compose([
    transforms.Resize((128, 128)),
    transforms.ToTensor(),
    transforms.Normalize(mean=[0.485, 0.456, 0.406],
                         std=[0.229, 0.224, 0.225])
])

material_model = SimpleCNN(num_classes=len(material_classes)).to(device)
checkpoint = torch.load(material_checkpoint, map_location=device)
material_model.load_state_dict(checkpoint['model_state'])
material_model.eval()

# =========================
# 3. 加载图片并预测
# =========================
image = Image.open(img_path).convert("RGB")

# 情绪预测
emo_img = emotion_transform(image).unsqueeze(0).to(device)
with torch.no_grad():
    emo_output = emotion_model(emo_img)['expression']
    emo_pred = emo_output.argmax(dim=1).item()
    emotion = emotion_classes[emo_pred]

# 材质预测
mat_img = material_transform(image).unsqueeze(0).to(device)
with torch.no_grad():
    mat_output = material_model(mat_img)
    mat_pred = mat_output.argmax(dim=1).item()
    material = material_classes[mat_pred]

# =========================
# 输出结果
# =========================
print(f"This may be a {emotion} {material} mask.")
